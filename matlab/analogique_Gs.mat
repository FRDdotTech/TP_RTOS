%% Identification fonction de transfert boîtier papillon
% Fichiers attendus : step_0_10.csv, step_0_20.csv, ..., step_0_70.csv
% Format de chaque ligne :
%   temps_ms, raw response, valeur_ADC
% Exemple :
%   000000, raw response, 02304

clear; clc; close all;

%% Calibration ADC
ADC_0   = 1955;    % ADC à 0 % de duty / papillon fermé
ADC_100 = 2850;    % ADC à 100 % de duty / papillon ouvert

%% Liste des essais
% Nom de fichier        duty initial   duty final
files = {
    'step_0_10.csv', 0, 10;
    'step_0_20.csv', 0, 20;
    'step_0_30.csv', 0, 30;
    'step_0_40.csv', 0, 40;
    'step_0_50.csv', 0, 50;
    'step_0_60.csv', 0, 60;
    'step_0_70.csv', 0, 70
};

nTests = size(files, 1);

%% Préparation des figures et résultats
figure('Name','Réponses indicielles mesurées');
hold on;

results = table(...
    strings(nTests,1), ...
    zeros(nTests,1), ...
    zeros(nTests,1), ...
    zeros(nTests,1), ...
    zeros(nTests,1), ...
    'VariableNames', ...
    {'Fichier','Duty_initial_pct','Duty_final_pct','ADC_initial','ADC_final'});

all_t = {};
all_u = {};
all_y = {};
Ts_all = [];

%% Lecture et prétraitement de chaque essai
for k = 1:nTests

    filename = files{k,1};
    d_init   = files{k,2};
    d_final  = files{k,3};

    if ~isfile(filename)
        warning('Fichier absent : %s', filename);
        continue;
    end

    % Lecture robuste du format : entier, texte, entier
    fid = fopen(filename, 'r');
    C = textscan(fid, '%d %s %d', 'Delimiter', ',');
    fclose(fid);

    t_ms = C{1};
    adc  = C{3};

    % Conversion en secondes
    t = t_ms / 1000;

    % Nettoyage : temps croissant et valeurs finies
    [t, ia] = unique(t, 'stable');
    adc = adc(ia);

    valid = isfinite(t) & isfinite(adc);
    t = t(valid);
    adc = adc(valid);

    if numel(t) < 20
        warning('Pas assez de points dans %s', filename);
        continue;
    end

    Ts = median(diff(t));
    Ts_all(end+1) = Ts; %#ok<SAGROW>

    % Signal d'entrée duty cycle, normalisé entre 0 et 1
    u = d_init/100 * ones(size(t));
    u(t >= t(1)) = d_final/100;  % échelon appliqué dès le début de l'enregistrement

    % Signal de sortie : position normalisée, puis angle équivalent
    position = (adc - ADC_0) / (ADC_100 - ADC_0);
    y = position * 90;   % angle équivalent en degrés

    % Sauvegarde pour identification globale
    all_t{end+1} = t; %#ok<SAGROW>
    all_u{end+1} = u; %#ok<SAGROW>
    all_y{end+1} = y; %#ok<SAGROW>

    % Résultats statiques
    ADC_init = median(adc(1:max(5,round(0.05*numel(adc)))));
    ADC_final = median(adc(end-max(5,round(0.05*numel(adc)))+1:end));

    results.Fichier(k) = string(filename);
    results.Duty_initial_pct(k) = d_init;
    results.Duty_final_pct(k) = d_final;
    results.ADC_initial(k) = ADC_init;
    results.ADC_final(k) = ADC_final;

    % Tracé
    plot(t, adc, 'DisplayName', sprintf('%d %% -> %d %%', d_init, d_final));
end

xlabel('Temps [s]');
ylabel('ADC raw');
title('Réponses à des échelons de duty cycle');
grid on;
legend('Location','best');

%% Carte statique : duty final -> ADC final
figure;
plot(results.Duty_final_pct, results.ADC_final, 'o-', 'LineWidth', 1.5);
xlabel('Duty cycle final [%]');
ylabel('ADC final');
title('Caractéristique statique duty -> ADC');
grid on;

%% Identification globale
% On concatène tous les essais dans un seul jeu de données.
% Chaque essai redémarre à t = 0 ; iddata accepte des cellules de signaux.

Ts = median(Ts_all);
fprintf('Période d''échantillonnage retenue : %.6f s\n', Ts);

z = iddata(all_y, all_u, Ts);
z.InputName = 'duty';
z.OutputName = 'angle';
z.TimeUnit = 'seconds';

%% Modèle du premier ordre
% G1(s) = K / (tau*s + 1)
G1 = tfest(z, 1, 0);

%% Modèle du second ordre
% G2(s) = K*wn^2 / (s^2 + 2*zeta*wn*s + wn^2)
G2 = tfest(z, 2, 0);

%% Affichage des modèles
G1
G2

%% Comparaison modèle / mesures
figure;
compare(z, G1, G2);
title('Comparaison des modèles identifiés');

%% Réponses indicielles des modèles
figure;
step(G1, 'r', 5);
hold on;
step(G2, 'b', 5);
grid on;
legend('Modèle 1er ordre', 'Modèle 2e ordre');
title('Réponse indicielle des modèles identifiés');

%% Export des résultats
writetable(results, 'resultats_echelons.csv');

G1_tf = tf(G1);
G2_tf = tf(G2);

writetable(...
    [num2cell(G1_tf.Numerator{:}), num2cell(G1_tf.Denominator{:})], ...
    'G1_coefficients.csv');

writetable(...
    [num2cell(G2_tf.Numerator{:}), num2cell(G2_tf.Denominator{:})], ...
    'G2_coefficients.csv');